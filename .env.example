# Non-secret settings (config.py). Secrets are NOT here — they are files in
# ./secrets/, one per secret (see `secrets:` in compose.yaml and docs/operations.md):
#   postgres_password  redis_password  vk_bot_token  payments_password  cookie_secret
# Anything commented out has a default in config.py.

# Docker Compose files. Locally: base + dev differences (reload, watch, Postgres port).
# Leave unset on the server (compose.yaml only).
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# VK community the bot works in
VK_GROUP_ID=

# Project owner(s): user management commands and technical notifications.
# Comma-separated VK IDs.
OWNER_VK_IDS=

# Web address for links in the bot keyboard («Оплаты», «День концерта»), no trailing slash.
# Unset — the bot shows no link buttons.
SITE_URL=

# Set to false for local HTTP development; keep true behind HTTPS
COOKIE_SECURE=false

# Defaults: POSTGRES_HOST=localhost (Compose: postgres), POSTGRES_PORT=5432,
# POSTGRES_DB=tickets, POSTGRES_USER=tickets; REDIS_HOST=localhost (Compose: redis),
# REDIS_PORT=6379, REDIS_DB=0
# SEAT_PRICE=1500
# DEBTORS_REMINDER_MIN_DAYS=7
# DISPLAY_TZ=Europe/Moscow
# LOG_LEVEL=INFO
# SQL_ECHO=false
# BACKUP_KEEP=14
# BACKUP_SEND_TO_VK=true
