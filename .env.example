# Docker Compose files. Locally: base + dev differences (reload, watch, Postgres port).
# Leave unset on the server (compose.yaml only).
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# VK Bot Configuration
VK_BOT_TOKEN=your_vk_bot_token_here
VK_GROUP_ID=your_vk_group_id_here

# Project owner(s): user management commands and technical notifications.
# Comma-separated VK IDs.
OWNER_VK_IDS=

# Redis Configuration (FSM storage)
# REDIS_PASSWORD is required for Compose (redis-server --requirepass);
# REDIS_HOST is overridden to "redis" inside Compose
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Database (config.DatabaseSettings). Host/port/user/db default to
# localhost:5432 tickets/tickets; Compose sets POSTGRES_HOST=postgres
POSTGRES_PASSWORD=tickets

# Business Logic
SEAT_PRICE=1500
DEBTORS_REMINDER_MIN_DAYS=7

# Payments page
PAYMENTS_PASSWORD=
# Cookie signing secret, required (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))")
COOKIE_SECRET=
# Set to false for local HTTP development; keep true behind HTTPS
COOKIE_SECURE=true

# Logging
LOG_LEVEL=INFO
SQL_ECHO=false
