[Unit]
Description=Tickets Web UI
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/spring-tickets
ExecStart=%h/spring-tickets/.venv/bin/uvicorn web.app:app --host 0.0.0.0
Restart=always
RestartSec=5
EnvironmentFile=%h/spring-tickets/.env

StandardOutput=append:%h/spring-tickets/logs/web.log
StandardError=append:%h/spring-tickets/logs/web.log

[Install]
WantedBy=default.target
