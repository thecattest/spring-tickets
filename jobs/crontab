# Расписание фоновых задач — сервис cron (supercronic). Время — московское.
# Формат: минута час день месяц день_недели команда
# Проверить синтаксис: docker compose run --rm cron supercronic -test jobs/crontab
CRON_TZ=Europe/Moscow

# Бэкап базы каждый день в 04:00, дамп — владельцу в VK (BACKUP_SEND_TO_VK)
0 4 * * * python -m jobs.backup

# Напоминания билетёрам о должниках раз в 3 дня в 20:00
# (*/3 по дням месяца: 1, 4, …, 28, 31 — на стыке месяцев интервал 1–3 дня)
0 20 */3 * * python -m jobs.debtors
